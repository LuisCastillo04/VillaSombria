[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/core/game.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/actors/player.tscn" id="2"]
[ext_resource type="Script" path="res://scripts/player/exploration_camera.gd" id="3"]
[ext_resource type="PackedScene" path="res://scenes/ui/hud.tscn" id="4"]
[ext_resource type="PackedScene" path="res://scenes/ui/screen_fade.tscn" id="5"]
[ext_resource type="PackedScene" path="res://scenes/world/post_fx.tscn" id="6"]
[ext_resource type="PackedScene" path="res://scenes/ui/dialogue_ui.tscn" id="7"]
[ext_resource type="PackedScene" path="res://scenes/ui/clue_inspector.tscn" id="8"]
[ext_resource type="PackedScene" path="res://scenes/ui/journal_ui.tscn" id="9"]
