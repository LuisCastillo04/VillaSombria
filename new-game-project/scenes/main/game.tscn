[ext_resource type="PackedScene" path="res://scenes/ui/case_closed_ui.tscn" id="13"]

[node name="Game" type="Node"]
script = ExtResource("1")

[node name="WorldRoot" type="Node3D" parent="."]

[node name="Player" parent="." instance=ExtResource("2")]

[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("3")

[node name="Camera3D" type="Camera3D" parent="CameraRig"]

[node name="PostFx" parent="." instance=ExtResource("6")]

[node name="Hud" parent="." instance=ExtResource("4")]

[node name="DialogueUi" parent="." instance=ExtResource("7")]

[node name="ClueInspector" parent="." instance=ExtResource("8")]

[node name="JournalUi" parent="." instance=ExtResource("9")]

[node name="BoardUi" parent="." instance=ExtResource("10")]

[node name="AccusationUi" parent="." instance=ExtResource("11")]

[node name="PauseMenu" parent="." instance=ExtResource("12")]

[node name="CaseClosedUi" parent="." instance=ExtResource("13")]

[node name="ScreenFade" parent="." instance=ExtResource("5")]
