; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Villa Sombría"
config/description="Aventura detectivesca 2.5D low-poly noir."
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/max_fps=60
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.04, 0.06, 1)

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameData="*res://scripts/autoload/game_data.gd"
GameState="*res://scripts/autoload/game_state.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Investigation="*res://scripts/autoload/investigation.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
StoryDirector="*res://scripts/autoload/story_director.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Settings="*res://scripts/autoload/settings.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/vsync/vsync_mode=0
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

