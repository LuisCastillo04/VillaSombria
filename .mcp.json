{
  "mcpServers": {
    "godot": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "godot-mcp-server@0.6.0"
      ]
    },
    "blender": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "mcp-for-blender==2.3.1",
        "mcp-for-blender"
      ],
      "env": {
        "DISABLE_TELEMETRY": "true",
        "BLENDERMCP_NO_UPDATE_CHECK": "1"
      }
    }
  }
}
